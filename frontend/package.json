{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build",
    "build:electron": "node scripts/build-electron.mjs && node scripts/prepare-electron-export.mjs",
    "start": "next start -H 0.0.0.0 -p 4001",
    "start:vaysen-crm": "next start -H 0.0.0.0 -p 4001",
    "start:surfacepolish": "next start -H 0.0.0.0 -p 4002",
    "lint": "next lint",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "verify:build-contract": "node scripts/build-electron.mjs --check && npm run build:web && npm run build:electron && npm run test:contract",
    "test:coverage": "vitest run --coverage",
    "quality:check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:styles && npm run test:run",
    "quality:changed": "npm run typecheck && npm run lint && npm run format",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "ratchet:record": "node scripts/quality-ratchet.mjs --record",
    "ratchet:check": "node scripts/quality-ratchet.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "next-intl": "^4.13.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.76.1",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-plugin-security": "^3.0.1",
    "jsdom": "^25.0.1",
    "msw": "2.12.4",
    "postcss": "^8",
    "prettier": "^3.9.0",
    "shadcn": "^4.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "14.2.33"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "cosmiconfig": {
      "js-yaml": "4.3.1"
    },
    "eslint": {
      "js-yaml": "4.3.1"
    },
    "nanoid": "3.3.18"
  }
}
