# 数据库连接
DATABASE_URL=postgresql://vaysen-crm:vaysen-crm_password@localhost:5432/vaysen-crm_pilot?schema=public

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=change-this-jwt-secret
JWT_REFRESH_SECRET=change-this-refresh-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 邮件加密密钥（32 字符随机字符串，生成命令见 DEPLOYMENT.md）
EMAIL_ENCRYPTION_KEY=change-this-32-char-random-key

# 应用端口
PORT=4000
ENABLE_SWAGGER=false

# 前端地址（CORS）
FRONTEND_URL=http://localhost:4001

# AI provider defaults
AI_EXTERNAL_CALLS_ENABLED=true
