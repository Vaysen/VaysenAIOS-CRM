# ============ R111 批次C：WhatsApp 批量营销执行器 ============
# 生产安全开关：默认 true —— 开启广播限制时，营销活动 whatsapp 执行器直接 BLOCKED 拒绝
# （入队侧与 worker 侧双重拦截，run 记录 status=BLOCKED, lastError=WHATSAPP_BROADCAST_DISABLED）。
# 验证通过后由运维显式置为 false 开启。
WHATSAPP_BROADCAST_DISABLED=true
# 兼容别名（二选一，任一为 true/false 均生效）
# WHATSAPP_BROADCAST_ENABLED=false

# 营销执行总开关（沿用批次2）：false 时十道闸 executionEnabled 拦截，活动级入队 BLOCKED
# MARKETING_EXECUTION_ENABLED=true

# 投放节点白名单（缺省放行；逗号分隔 hostname）
# MARKETING_EXECUTION_NODE_WHITELIST=

# worker-marketing-delivery 是否恢复 Baileys 会话（发送依赖进程内 live socket）
# 注意：同一 WhatsApp 账号同时只允许一个进程持有连接（主 API 与 worker 勿同时 restore）
WHATSAPP_RESTORE_SESSIONS=true

# 每账号风控（DB 默认：60/小时、300/天、8 秒间隔；可由 PATCH /whatsapp/accounts/:id 调整）
# 执行器按 ExternalActionOutbox 滚动窗口计数 enforce，超限暂停任务延迟重入队
