# ============================================================
# Vaysen AI CRM — Preview Environment Variables
# Copy to .env.preview and fill in before deployment.
# ALL keys below are PLACEHOLDERS. Replace with real values.
# ============================================================

# ---- Database ----
DB_USER=vaysen-crm
DB_PASSWORD=change-me-to-strong-password
DB_NAME=vaysen-crm_pilot

# ---- Auth (generate with: openssl rand -base64 32) ----
JWT_SECRET=change-me-jwt-secret-preview
JWT_REFRESH_SECRET=change-me-jwt-refresh-preview
EMAIL_ENCRYPTION_KEY=00000000000000000000000000000000

# ---- URLs (change SERVER_IP to actual server address) ----
API_BASE_URL=http://SERVER_IP:4000
FRONTEND_URL=http://SERVER_IP:4001
CORS_ORIGIN=http://SERVER_IP:4001
NEXT_PUBLIC_API_URL=http://SERVER_IP:4000/api

# ---- Safety Switches (DO NOT enable for preview) ----
EMAIL_SEND_ENABLED=false
WHATSAPP_SEND_ENABLED=false
AI_EXTERNAL_CALLS_ENABLED=false
MARKETING_EMAIL_WORKERS_ENABLED=false

# ---- App Mode ----
NODE_ENV=production
APP_MODE=preview
ENABLE_SWAGGER=true

# ---- AI (optional, leave blank to disable) ----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash-250414

# ---- Email (optional, leave blank for preview) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Ports ----
BACKEND_PORT=4000
FRONTEND_PORT=4001
