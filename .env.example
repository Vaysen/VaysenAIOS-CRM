# =============================================================================
# vaysen-ai-crm - 环境变量配置模板
# 使用方法：复制此文件为 .env 并修改其中的值
#   cp .env.example .env
# =============================================================================

# ----------------------------------------------------------------------------
# 数据库配置 (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_USER=vaysen-crm
POSTGRES_DB=vaysen-crm_pilot
# docker-compose.prod.yml 的唯一数据库密码变量；不要另写 POSTGRES_PASSWORD。
DB_PASSWORD=change-this-password
# 本地非 Compose 运行可显式设置；生产 Compose 会用 DB_PASSWORD 组装同一连接串。
DATABASE_URL=postgresql://vaysen-crm:change-this-password@postgres:5432/vaysen-crm_pilot

# ----------------------------------------------------------------------------
# Redis 配置
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ----------------------------------------------------------------------------
# JWT 认证密钥（生产环境务必修改为强随机字符串）
# 生成方式：openssl rand -hex 32
# ----------------------------------------------------------------------------
JWT_SECRET=your-secret-key-change-me
JWT_REFRESH_SECRET=your-refresh-secret-key-change-me

# 邮件加密密钥（必须为 32 字符）
EMAIL_ENCRYPTION_KEY=change-me-32-chars-encryption!!

# ----------------------------------------------------------------------------
# 服务端口配置
# ----------------------------------------------------------------------------
API_PORT=4000
FRONTEND_PORT=3000
ENABLE_SWAGGER=false
LAN_BIND_IP=127.0.0.1
# 必须与上方完全一致；部署校验器拒绝 0.0.0.0、公网 IP 或未经批准的网卡地址。
APPROVED_LAN_BIND_IP=127.0.0.1
# 当前物理局域网地址。设备搬家或 DHCP 地址变化后只更新这两个值；
# ZeroTier 地址保持不变，两个入口都只绑定明确的私网网卡。
LOCAL_LAN_BIND_IP=127.0.0.1
APPROVED_LOCAL_LAN_BIND_IP=127.0.0.1
# 客户附件、定制素材、WhatsApp 登录态的宿主持久目录（项目目录之外）。
APP_DATA_DIR=/var/lib/vaysen-crm/data
APP_DATA_UID=999
APP_DATA_GID=999
# Pre-create this deployment-user-owned directory with mode 700 or 750. It is
# exclusively for disposable restored-database rehearsals and must not overlap
# the project, backup, release, application-data, or Docker data directories.
MIGRATION_REHEARSAL_DATA_ROOT=/var/lib/vaysen-crm/rehearsals
MIGRATION_REHEARSAL_MAX_SECONDS=90
MIGRATION_REHEARSAL_MAX_RESTORE_SECONDS=900
PRODUCTION_MIGRATION_TIMEOUT_SECONDS=120
# The official OpenClaw image runs as node uid/gid 1000. These values are
# fixed by the production validator and are intentionally separate from Nest.
OPENCLAW_DATA_UID=1000
OPENCLAW_DATA_GID=1000

# ----------------------------------------------------------------------------
# Python 图像处理微服务地址（容器内通信）
# ----------------------------------------------------------------------------
IMAGE_PROCESSOR_URL=http://python-service:5000

# ----------------------------------------------------------------------------
# CORS 跨域配置
# ----------------------------------------------------------------------------
CORS_ORIGIN=http://127.0.0.1:4001
FRONTEND_URL=http://127.0.0.1:4001
API_BASE_URL=http://127.0.0.1:4000/api
# Web 与 Electron 均使用同源入口；Electron 主进程再代理至上方 API_BASE_URL。
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=Vaysen AI CRM

# ----------------------------------------------------------------------------
# Electron 局域网客户端（默认值已内置，以下仅用于高级覆盖）
# ----------------------------------------------------------------------------
APPROVED_ZEROTIER_API_ORIGINS=http://127.0.0.1
ELECTRON_UPDATER_ENABLED=false
ELECTRON_UPDATER_URL=

# ----------------------------------------------------------------------------
# 外发邮件公网回调（可选）
# 本系统服务仅在局域网时请保持为空：系统会保留原始 CTA、关闭像素/点击跟踪，
# 并使用“回复本邮件并注明 Unsubscribe”的退订说明，绝不向客户暴露任何私网地址。
# 如未来有经过批准的公网 HTTPS 回调，可填写：
# PUBLIC_TRACKING_BASE_URL=https://mail.example.com
# PUBLIC_UNSUBSCRIBE_URL=https://www.example.com/unsubscribe/{token}
# ----------------------------------------------------------------------------
PUBLIC_TRACKING_BASE_URL=
PUBLIC_UNSUBSCRIBE_URL=

# 初次部署保持外发总闸关闭；模板/历史草稿复核通过后才可显式改为 false。
EMAIL_SEND_DISABLED=true
# 种子测试默认关闭，且不提供任何硬编码个人邮箱。
EMAIL_SEED_TEST_ENABLED=false
EMAIL_SEED_TEST_ADDRESS=
EMAIL_SEED_TEST_APPROVED_ADDRESSES=
EMAIL_SEED_TEST_INTERVAL=100
# 邮件账号仅在明确需要跨用户共享池时开启。
EMAIL_ACCOUNT_SHARED_POOL=false

# Brevo free email integration (SMTP sending + inbound email parsing)
# SMTP account values are saved from the Email Accounts page.
# Create a random token of at least 32 characters and configure the same Bearer
# token in the Brevo inbound webhook. Leave empty to keep the public endpoint disabled.
BREVO_INBOUND_WEBHOOK_TOKEN=
BREVO_INBOUND_DOMAIN=

# ----------------------------------------------------------------------------
# AI 服务配置（按需填写）
# ----------------------------------------------------------------------------
# 智谱 GLM（生产默认 AI Provider）
AI_EXTERNAL_CALLS_ENABLED=true
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash-250414
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value

# ----------------------------------------------------------------------------
# Isolated OpenClaw business-assistant runtime
# Generate the two secrets independently, for example: openssl rand -hex 32
# The Gateway token is backend-only and must never be placed in NEXT_PUBLIC_*.
# ----------------------------------------------------------------------------
OPENCLAW_ENABLED=true
OPENCLAW_RUNTIME_VERSION=2026.7.1
OPENCLAW_WEIXIN_PLUGIN_VERSION=2.4.6
OPENCLAW_GATEWAY_TOKEN=replace-with-an-independent-64-char-secret
OPENCLAW_CRM_HMAC_KEY_ID=vaysen-openclaw-v1
OPENCLAW_CRM_HMAC_SECRET=replace-with-another-independent-64-char-secret
OPENCLAW_OWNER_EMAIL=admin@example.com
OPENCLAW_OWNER_COMPANY_SLUG=example-trading-company
# Populated only by scripts/openclaw-weixin-login.sh after the owner scans QR.
OPENCLAW_WECHAT_OWNER_PEER_SHA256=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=

# Firecrawl（网页抓取）
FIRECRAWL_API_KEY=

# ----------------------------------------------------------------------------
# AI 路由策略（逗号分隔，按顺序回退）
# ----------------------------------------------------------------------------
AI_ROUTE_CLEAN=zhipu,ollama,nvidia
AI_ROUTE_PROFILE=zhipu,ollama,nvidia
AI_ROUTE_EMAIL=zhipu,ollama
AI_ROUTE_RESEARCH=zhipu,nvidia
BUSINESS_BRAND_NAME=Example Trading Company
BUSINESS_DESCRIPTION=Replace with your company description
BUSINESS_PRODUCT_FOCUS=Replace with your products and services
BUSINESS_TARGET_CUSTOMER_PROFILE=Replace with your ideal customer profile
ENABLE_AI_DIAGNOSTICS=false

# 正式后端保持 true；连接生产数据库的隔离候选实例必须显式覆盖为 false，
# 避免第二个进程恢复、抢占或改写在线 WhatsApp 会话。
WHATSAPP_RESTORE_SESSIONS=true
# 仅供后端 Baileys 使用；不要填写容器通用 HTTP_PROXY/HTTPS_PROXY。
# 代理必须能从 backend 容器访问并支持 WhatsApp WebSocket。
WHATSAPP_PROXY=
# 正式 API 实例保持 true；隔离候选必须为 false，避免扫描并重排生产背调任务。
DEEP_RESEARCH_RECONCILE_ENABLED=true

# Optional Evolution API integration is not deployed in the LAN release and is
# fail-closed. Keep disabled unless all four values below are provisioned and
# the webhook is reachable from the approved Evolution service.
EVOLUTION_API_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
BACKEND_URL=http://127.0.0.1

# Optional legacy Markdown lead import. It is fail-closed unless both settings are explicit.
EXTERNAL_LEAD_ARCHIVE_ENABLED=false
EXTERNAL_LEAD_ARCHIVE_PATH=
# 生产部署必须填写已审核的不可变镜像 digest，禁止可变 tag/latest。
# 示例格式：repository/name@sha256:<64位摘要>
NODE_IMAGE=
PYTHON_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
NGINX_IMAGE=
REACHER_IMAGE=
SEARXNG_IMAGE=
N8N_IMAGE=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw@sha256:6a31d44b2944e7adcd2b582bf6fb463111264ebca97a0201795b799135bd102c
